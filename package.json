{
  "name": "time-center",
  "productName": "Time Center",
  "version": "0.1.0",
  "description": "Mac tray app that tracks where your time goes, joins meetings on time, and turns them into TODOs.",
  "author": "Ryan Shillington",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --mac --dir",
    "dist": "electron-vite build && electron-builder --mac",
    "spike:audio:electron": "rolldown spike/system-audio/electronLoopback.ts --file out/spike/electronLoopback.cjs --format cjs --platform node --external electron && electron out/spike/electronLoopback.cjs",
    "spike:audio:tap": "swift spike/system-audio/AudioTapProbe.swift \"${TMPDIR}time-center-spike-tone.wav\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
